# 기존 미등록 테스트는 계속 제외하고, 경유지 탐색 테스트만 공유합니다.
/tests/*
!/tests/unit/
/tests/unit/*
!/tests/unit/test_waypoint_beam.py
!/tests/unit/test_waypoint_alns.py
!/tests/unit/test_waypoint_evaluation.py
