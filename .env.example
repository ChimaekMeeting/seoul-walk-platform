# PostgreSQL (Docker Compose와 동일하게)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seoul_walk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Valkey
VALKEY_URI=your_valkey_uri

# 지도
MAPBOX_API_KEY=your_mapbox_key

# 날씨/대기질
WEATHER_API_KEY=your_weather_key
AIR_KOREA_API_KEY=your_air_key

# NLP
OPENAI_API_KEY=your_openai_key

# kakao
KAKAO_API_KEY=your_kakao_api_key
KAKAO_REDIRECT_URI=your_kakao_login_redirect_uri e.g., /api/login/kakao/callback

# JWT
SECRET_KEY=your_jwt_secret_key